direction: right

client: "Robot Dog / Caller"

api: {
  label: "API Layer"
  app: "api/app.py"
  schemas: "api/schemas.py"
}

workflow: {
  label: "Workflow Layer"
  inspection: "workflows/inspection_event_workflow.py"
}

prompts: {
  label: "Prompt Layer"
  builders: "prompts/builders.py"
}

model_clients: {
  label: "Model Client Layer"
  mock: "model_clients/mock_clients.py"
  http: "model_clients/http_clients.py"
}

plugins: {
  label: "Plugin Layer"
  callback: "plugins/http_callback.py"
}

infra: {
  label: "Infra Layer"
  config: "infra/config.py"
  store: "infra/event_store.py"
}

domain: {
  label: "Domain Layer"
  events: "domain/events.py"
  evidence: "domain/evidence.py"
  taxonomy: "domain/taxonomy.py"
}

services: {
  label: "Service Layer"
  feedback: "services/feedback.py"
}

vlm1_service: "VLM-1 Service\nSGLang/vLLM"
sam3_service: "SAM3 Service\nFastAPI"
vlm2_service: "VLM-2 Service\nSGLang/vLLM"
callback_service: "Backend Management Service"

stub_vlm1: "Stub /mock/vlm/preliminary"
stub_vlm2: "Stub /mock/vlm/judge"
stub_sam3: "Stub /mock/sam3/segment"

client -> api
api -> workflow
api -> infra.store: "query by event_id"
api -> infra.config: "load app config"

workflow -> model_clients
workflow -> services.feedback
workflow -> domain
workflow -> infra.store
model_clients -> prompts
model_clients -> vlm1_service
model_clients -> sam3_service
model_clients -> vlm2_service
workflow -> plugins.callback
plugins.callback -> callback_service

api -> stub_vlm1
api -> stub_vlm2
api -> stub_sam3

style.fill: "#f8fafc"
